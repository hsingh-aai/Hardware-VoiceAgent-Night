# secrets - never commit
src/secrets.h
relay/.env

# build output
.pio/
.vscode/
__pycache__/
*.pyc

# runtime data: conversation transcripts and recordings.
# These hold real speech, including a child's. Keep them local.
relay/session.jsonl
relay/tests.jsonl
relay/notes.jsonl
*.blend1

# Seeed's XVF3800 firmware images - 3.5 MB of vendor binaries that are
# versioned upstream. firmware/xvf3800/README.md says how to fetch them.
firmware/xvf3800/*.bin

# Furby's memory: real personal facts, rewritten at runtime by the "remember"
# tool. relay/memory.example.md shows the shape; copy it to memory.md.
relay/memory.md

# macOS Finder metadata
.DS_Store
